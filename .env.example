# Jev (TypeSafe System One). Get a key at https://typesafe.ai
TYPESAFE_API_KEY=
# Optional: another System One endpoint, e.g. https://openrouter.ai/api with an OpenRouter key
# TYPESAFE_BASE_URL=
# Optional: pin the model (default jev-1.13.0)
# TYPESAFE_DEFAULT_MODEL=

# treg (X search). Not needed when `treg login` has been run on this machine.
TREG_TOKEN=
# Only for identity tokens
TREG_ORG=

# Optional: post alerts from `pnpm scout notify` to a Slack incoming webhook
SLACK_WEBHOOK_URL=

# Optional: profile to use when --profile is not given (default scout.yaml)
# SCOUT_PROFILE=profiles/starter.yaml
# Optional: `pnpm scout notify` holds alerts during quiet hours; set to 0 to disable
# SCOUT_QUIET_HOURS=0
