// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`profile > keeps the questions Jev receives for the ai-apps example 1`] = `
"{
 "filter": {
  "topic": {
   "type": "choice",
   "instructions": {
    "question": "Which topic is this X post mainly about?",
