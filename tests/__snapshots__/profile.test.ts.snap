   },
   "criteria": {
    "ai_host": {
     "what": "AI assistants as distribution platforms: apps, plugins or connectors inside ChatGPT, Claude, Codex, Cowork, Gemini, Muse or Grok; their directories, submission rules, install flows, ads and discovery",
     "not_for": "the ChatGPT or Claude mobile/desktop application's own features, outages or bugs unrelated to apps",
     "examples": [
      "Starting today you can connect multiple accounts with most plugins in ChatGPT",
      "Muse connectors platform is open to developers"
     ]
    },
    "protocol": {
     "what": "protocols and standards for agents and AI apps: MCP, MCP Apps, WebMCP, A2A, A2UI, AAIF, Agent Plugins, agent auth (ID-JAG), and products adopting them",
     "not_for": "commerce and payment protocols (that is agentic_commerce)",
     "examples": [
      "Stripe implemented WebMCP",
      "A2A joins AAIF",
      "New MCP spec release"
     ]
    },
    "agentic_commerce": {
     "what": "AI agents that shop, check out or pay: UCP, Agentic Commerce Protocol, AP2, x402, agentic checkout, AI Mode checkout, agent payments",
     "not_for": "crypto price talk, token rallies, memecoins, blockchains or stablecoins joining x402, tokenization or 'machine economy' narratives from crypto and finance accounts, stock or investor commentary",
     "examples": [
      "Shopify merchants can now sell through Muse with Shop Pay",
      "Checkout in Google AI Mode"
     ]
    },
    "personal_agent": {
     "what": "personal agents and AI assistants acting for one person: Meta Muse, Instinct, Town, Grok Bot, ChatGPT Work, Claude Cowork, Microsoft Scout/Autopilot, OpenClaw, Hermes Agent — their launches, new platforms, features, funding, adoption and the race between them",
     "not_for": "courses, tips or 'monetize your own agent' promotions; coding agents used only for programming; crypto tokens named after agents; model releases or model rumours (that is other_ai); stock or investor commentary about these products",
     "examples": [
      "Muse passed 500K users in its first week",
      "Instinct raises $1B",
      "Muse is now available on Mac",
      "Across Muse, Instinct and Grok Bot, personal agents are going mainstream"
     ]
    },
    "other_ai": "about AI but none of the four topics",
    "off_topic": {
     "what": "not about AI products: politics, sports, personal life, and market commentary about AI companies",
     "examples": [
      "$META price target raised to $920",
      "AI tokens rallied 19% this week",
      "Muse will accelerate CPU orders for $AMD"
     ]
    }
   }
  },
  "speaker": {
   "type": "choice",
   "instructions": "Who is speaking, relative to the product in the post?",
   "criteria": {
    "maker": {
     "what": "the author or the author's company built and is launching or updating the product",
     "examples": [
      "We're happy to announce our plugin is now available"
     ]
    },
    "reporter": {
     "what": "the author reports or comments on someone else's product or news",
     "examples": [
      "Meta's new agent passed 2.6M downloads"
     ]
    },
    "promoter": {
     "what": "the author promotes someone else's product with hype or a call to action, like a paid influencer",
     "examples": [
      "Wait... you can build and monetize your own AI agent? With AITOPIA you can"
     ]
    },
    "user": {
     "what": "the author shares their own experience using a product",
     "examples": [
      "My OpenClaw now clears my inbox every morning"
     ]
    },
    "no_product": "no specific product: opinion, tutorial, course, meme"
   }
  },
  "excluded": {
   "type": "noul",
   "instructions": {
    "context": "Acme is an independent newsletter and consultancy for product teams that build apps inside AI assistants (ChatGPT plugins, Claude connectors, Muse connectors) and adopt agent protocols such as MCP.",
    "question": "Is this post promoting a course, a paid community, a newsletter or a giveaway?"
   }
  }
 },
 "score": {
  "significance": {
   "type": "score",
   "instructions": {
    "question": "How big is the update announced or reported in this post, for the AI agent and AI app ecosystem as a whole?",
    "focus": "Judge the update itself, not how excited the post sounds."
   },
   "criteria": [
    {
     "summary": "minor",
     "signals": [
